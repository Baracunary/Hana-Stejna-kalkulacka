# Zkopírujte tento soubor jako .env (lokální vývoj) a stejné hodnoty nastavte
# v nastavení projektu na Vercelu (Settings → Environment Variables).
# Podrobný návod, co kam vyplnit, je v README.md.

# --- Meta Pixel (klientská strana, veřejná hodnota) ---
PUBLIC_META_PIXEL_ID=

# --- Volitelná analytika (necháte prázdné, pokud ji nechcete používat) ---
PUBLIC_PLAUSIBLE_DOMAIN=

# --- Odeslání e-mailu s poptávkou přes Resend (https://resend.com) ---
RESEND_API_KEY=
# Odesílací adresa MUSÍ být z domény ověřené v Resendu, např.:
LEAD_EMAIL_FROM="Hypoteční kalkulačka <kalkulacka@vasedomena.cz>"
# Kam se poptávky posílají (výchozí je hana.stejna@4fin.cz, pokud necháte prázdné)
LEAD_EMAIL_TO=hana.stejna@4fin.cz

# --- Webhook do Make/n8n pro předání poptávky do CRM ---
LEAD_WEBHOOK_URL=

# --- Meta Conversions API (server-side Lead event, deduplikace s Pixelem) ---
META_CAPI_ACCESS_TOKEN=
# Volitelné: kód pro testovací eventy v Events Manageru, při ostrém provozu nechte prázdné
META_TEST_EVENT_CODE=
